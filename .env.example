# Copy to .env and adjust. Never commit the real .env file.

# --- Public access ---------------------------------------------------------
HTTP_PORT=80
# URL used by players (https:// enables secure cookies).
PUBLIC_URL=http://localhost

# --- Secrets (required) ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-with-at-least-32-random-characters
POSTGRES_PASSWORD=change-me

# --- Accounts --------------------------------------------------------------
# Comma separated emails granted the admin role on registration/login.
ADMIN_EMAILS=
REGISTRATION_ENABLED=true

# --- Unciv updates ---------------------------------------------------------
# Optional token to raise the GitHub API rate limit.
GITHUB_TOKEN=
UPDATE_CHECK_INTERVAL_MINUTES=360
# When false, new releases are downloaded but an admin activates them manually.
AUTO_ACTIVATE_UPDATES=true

# --- Game sessions ---------------------------------------------------------
MAX_ACTIVE_SESSIONS=10
GAME_CPU_LIMIT=1
GAME_MEMORY_MB=1536
GAME_SCREEN_WIDTH=1600
GAME_SCREEN_HEIGHT=900
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_MAX_DURATION_HOURS=8

# --- Optional multiplayer server -------------------------------------------
# Start it with: docker compose --profile multiplayer up -d
# Players keep the choice between the official server, this one or their own.
MULTIPLAYER_SERVER_ENABLED=false
# Defaults to ${PUBLIC_URL}/multiplayer
MULTIPLAYER_SERVER_PUBLIC_URL=
